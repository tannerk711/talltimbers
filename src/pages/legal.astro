---
import Layout from '../layouts/Layout.astro';
import Topbar from '../components/Topbar.astro';
import Footer from '../components/Footer.astro';
import { brand } from '../config/funnel';
---

<Layout title={`Legal | ${brand.name}`}>
  <Topbar />
  <section class="bg-paper py-20">
    <div class="max-w-3xl mx-auto px-5 lg:px-10">
      <h1 class="font-display text-4xl tracking-tight mb-8">Legal Disclosures</h1>
      <div class="space-y-5 text-ink/70 leading-relaxed text-[0.95rem]">
        <p>
          <strong class="text-ink">{brand.name} originates DSCR investment property loans for real estate investors.</strong>
          Loans are originated by Adam C. Cunningham, Mortgage Loan Originator, NMLS #312817, through our
          network of wholesale lender partners. For licensing information, visit
          <a href={brand.licensingUrl} class="underline" rel="noopener" target="_blank">www.nmlsconsumeraccess.org</a>.
        </p>
        <p>
          This is not a commitment to lend. All loan approvals are subject to underwriting guidelines, credit
          review, and property appraisal. Rates, terms, and program availability are subject to change without
          notice. Loan terms, eligibility, and approval are subject to underwriting review and the originating
          lender's program requirements. Property types, locations, and borrower scenarios may not qualify
          under all programs.
        </p>
        <p>
          The eligibility check on this site is an informational pre-qualification screen. It is not a loan
          application, does not pull your credit, and does not guarantee approval or specific terms. Any DSCR
          figures shown on this site are educational illustrations, not quotes or offers of credit.
        </p>
        <p>
          Equal Housing Opportunity. This company is not endorsed by, nor acting on behalf of or at the
          direction of, any government agency.
        </p>
      </div>
    </div>
  </section>
  <Footer />
</Layout>
