---
import Layout from '../layouts/Layout.astro';
import Topbar from '../components/Topbar.astro';
import Footer from '../components/Footer.astro';
import { brand } from '../config/funnel';
---

<Layout title={`Privacy Policy | ${brand.name}`}>
  <Topbar />
  <section class="bg-paper py-20">
    <div class="max-w-3xl mx-auto px-5 lg:px-10">
      <h1 class="font-display text-4xl tracking-tight mb-8">Privacy Policy</h1>
      <div class="space-y-5 text-ink/70 leading-relaxed text-[0.95rem]">
        <p><em>Template placeholder. Replace with the client's actual privacy policy before launch.</em></p>
        <p>
          {brand.name} collects the information you submit through this site (name, contact details, and
          loan-scenario answers) solely to respond to your inquiry and provide loan services. We do not sell
          your personal information. Information may be shared with lending partners for the purpose of
          pricing and originating your loan.
        </p>
        <p>
          You may request access to or deletion of your data at any time by calling {brand.phone}.
        </p>
      </div>
    </div>
  </section>
  <Footer />
</Layout>
