---
import Layout from '../layouts/Layout.astro';
import Topbar from '../components/Topbar.astro';
import Footer from '../components/Footer.astro';
import { brand } from '../config/funnel';
---

<Layout title={`Eligibility Check Complete | ${brand.name}`} description="Your DSCR eligibility results. Book your consultation.">
  <Topbar />

  <!-- ============ RESULT HERO ============ -->
  <section class="bg-paper py-20 lg:py-24 relative overflow-hidden">
    <div class="absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r from-brass via-brass-2 to-brass"></div>
    <div class="max-w-3xl mx-auto px-5 lg:px-10 text-center relative z-10">

      <!-- brass seal -->
      <div class="mx-auto w-20 h-20 mb-8 relative">
        <svg viewBox="0 0 80 80" class="w-full h-full">
          <circle cx="40" cy="40" r="37" fill="none" stroke="var(--color-brass)" stroke-width="2.5"
            stroke-dasharray="233" stroke-dashoffset="233" id="seal-ring" />
          <circle cx="40" cy="40" r="30" fill="var(--color-pine)" opacity="0.08" />
          <path d="M26 41 l10 10 l19 -21" fill="none" stroke="var(--color-pine)" stroke-width="4.5"
            stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="46" stroke-dashoffset="46" id="seal-check" />
        </svg>
      </div>

      <p class="eyebrow text-moss mb-5">Eligibility check complete</p>
      <h1 class="font-display text-[clamp(2.2rem,4.5vw,3.6rem)] leading-[1.05] tracking-tight">
        <span id="ty-name">Congratulations</span>. Your file looks like
        <em class="italic text-pine">one we can close.</em>
      </h1>
      <p class="text-ink/65 text-lg leading-relaxed mt-5 max-w-xl mx-auto">
        The next step is a quick call with Adam. We run your scenario across our {brand.lenderCount} lender
        network, walk you through your options, and map your path to a formal pre-approval.
      </p>

      <!-- scenario chips (filled from sessionStorage) -->
      <div id="ty-chips" class="flex flex-wrap justify-center gap-2 mt-7"></div>
    </div>
  </section>

  <!-- ============ BOOKING ============ -->
  <section class="bg-paper-2 border-y border-ink/10 py-16 lg:py-20">
    <div class="max-w-4xl mx-auto px-5 lg:px-10">
      <div class="text-center mb-10">
        <h2 class="font-display text-[clamp(1.7rem,3vw,2.4rem)] tracking-tight">
          Grab a time that suits you
        </h2>
        <p class="text-ink/60 mt-3">30 minutes · video or phone · zero obligation</p>
      </div>

      {brand.bookingEmbedUrl ? (
        <div class="bg-paper border border-ink/10 rounded-2xl shadow-[var(--shadow-card)]">
          <iframe
            src={brand.bookingEmbedUrl}
            scrolling="yes"
            class="w-full rounded-2xl"
            style="height: min(1060px, calc(100vh - 120px)); overflow: auto; border: none;"
            title="Book your consultation"
          ></iframe>
        </div>
      ) : (
        <div class="bg-paper border border-ink/10 rounded-2xl shadow-[var(--shadow-card)] px-8 py-12 text-center">
          <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-ink/45 mb-4">Prefer to talk now?</p>
          <a href={brand.phoneHref} class="font-display text-[clamp(2rem,4vw,3rem)] text-pine hover:text-ink transition-colors">
            {brand.phone}
          </a>
          <p class="text-ink/55 text-sm mt-4">Or reply to the email we just sent to lock in a time.</p>
        </div>
      )}
    </div>
  </section>

  <!-- ============ WHAT HAPPENS NEXT ============ -->
  <section class="bg-paper py-20 lg:py-24">
    <div class="max-w-5xl mx-auto px-5 lg:px-10">
      <p class="eyebrow text-moss text-center mb-4">What happens next</p>
      <h2 class="font-display text-[clamp(1.8rem,3vw,2.5rem)] tracking-tight text-center mb-14">
        From here, it&rsquo;s three steps to funded.
      </h2>
      <div class="grid sm:grid-cols-3 gap-5">
        <div class="border border-ink/10 rounded-2xl bg-paper-2 p-7">
          <span class="font-display text-[2.2rem] text-brass leading-none">1</span>
          <h3 class="font-display text-lg mt-4 mb-2">Strategy call</h3>
          <p class="text-sm leading-relaxed text-ink/65">Adam reviews your file before the call, answers every question, and runs your deal against the lender network the same business day.</p>
        </div>
        <div class="border border-ink/10 rounded-2xl bg-paper-2 p-7">
          <span class="font-display text-[2.2rem] text-brass leading-none">2</span>
          <h3 class="font-display text-lg mt-4 mb-2">Formal pre-approval</h3>
          <p class="text-sm leading-relaxed text-ink/65">Same-day on clean files, so you can write offers or lock your refi terms with confidence.</p>
        </div>
        <div class="border border-ink/10 rounded-2xl bg-paper-2 p-7">
          <span class="font-display text-[2.2rem] text-brass leading-none">3</span>
          <h3 class="font-display text-lg mt-4 mb-2">Clear to close</h3>
          <p class="text-sm leading-relaxed text-ink/65">Appraisal, title, done. No income documentation, and you get a real timeline for your file on the first call.</p>
        </div>
      </div>

      <!-- specialist -->
      <div class="mt-14 max-w-md mx-auto text-center border border-ink/10 rounded-2xl bg-paper-2 px-8 py-8">
        <img
          src={brand.specialist.headshot}
          alt={brand.specialist.name}
          class="w-16 h-16 rounded-full object-cover object-top mx-auto mb-4 border border-ink/10"
          width="64"
          height="64"
          loading="lazy"
        />
        <div class="font-display text-lg">{brand.specialist.name}</div>
        <div class="font-mono text-[0.62rem] uppercase tracking-[0.18em] text-ink/50 mt-1.5">
          {brand.specialist.title} · {brand.specialist.nmls}
        </div>
      </div>
    </div>
  </section>

  <Footer />

  <script>
    import gsap from 'gsap';
    import { brand } from '../config/funnel';

    // personalize from the form summary
    let hasLead = false;
    try {
      const raw = sessionStorage.getItem('lead-summary');
      if (raw) {
        hasLead = true;
        const s = JSON.parse(raw);
        if (s.firstName) {
          const el = document.getElementById('ty-name');
          if (el) el.textContent = `Congratulations, ${s.firstName}`;
        }
        const labels: Record<string, string> = {
          purchase: 'Purchase', refinance: 'Refinance', cashout: 'Cash-out refi', bridge: 'Fix & flip',
          sfr: 'Single family', '2-4': '2–4 units', '5-9': '5–9 units', '10+': '10+ units',
          commercial: 'Commercial', other: 'Other property',
        };
        const price = typeof s.price === 'number'
          ? s.price >= 2_000_000 ? '$2M+' : `$${Number(s.price).toLocaleString()}`
          : null;
        const chips = [labels[s.goal], labels[s.propertyType], s.state, price, s.credit ? `Credit ${s.credit}` : null].filter(Boolean);
        const wrap = document.getElementById('ty-chips');
        if (wrap) {
          chips.forEach((c) => {
            const span = document.createElement('span');
            span.className = 'font-mono text-[0.62rem] uppercase tracking-[0.14em] bg-pine/10 text-pine border border-pine/20 rounded-full px-3 py-1.5';
            span.textContent = String(c);
            wrap.appendChild(span);
          });
        }
      }
    } catch { /* fine */ }

    // seal animation
    gsap.to('#seal-ring', { strokeDashoffset: 0, duration: 1.1, ease: 'power2.inOut', delay: 0.2 });
    gsap.to('#seal-check', { strokeDashoffset: 0, duration: 0.7, ease: 'power2.out', delay: 1.0 });

    // Google Ads "New Lead" conversion. Fires for real submissions (lead-summary
    // in sessionStorage) AND the ?demo=1 preview so Google Tag Assistant can
    // verify the tag at /thank-you?demo=1. Never fires on a bare direct visit,
    // so bots and accidental loads do not inflate conversion counts.
    const isDemo = new URLSearchParams(window.location.search).get('demo') === '1';
    if (brand.gtagConversion && (hasLead || isDemo) && typeof (window as any).gtag === 'function') {
      (window as any).gtag('event', 'conversion', { send_to: brand.gtagConversion });
    }
  </script>
</Layout>
