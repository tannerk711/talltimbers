---
import { brand } from '../config/funnel';
---

<footer class="bg-ink text-cream/60 border-t border-cream/10 py-14">
  <div class="max-w-5xl mx-auto px-5 lg:px-10 text-center">
    <img
      src={brand.logo}
      alt={brand.name}
      class="h-12 w-auto brightness-0 invert mx-auto mb-3"
      width="196"
      height="80"
      loading="lazy"
    />
    <p class="font-mono text-[0.62rem] uppercase tracking-[0.18em] mb-8">{brand.nmls}</p>
    <div class="text-[0.8rem] leading-relaxed max-w-3xl mx-auto space-y-3 text-left sm:text-center">
      <p>
        <strong class="text-cream/80">{brand.name} originates DSCR investment property loans for real estate investors.</strong>
        This is not a commitment to lend. Loans are originated by Adam C. Cunningham, Mortgage Loan Originator,
        NMLS #312817, through our network of wholesale lender partners. For licensing information visit
        <a href={brand.licensingUrl} class="underline hover:text-cream" rel="noopener" target="_blank">www.nmlsconsumeraccess.org</a>.
      </p>
      <p>
        Equal Housing Opportunity. All loan products are offered through licensed mortgage originators and their
        lender partners. Loan terms, eligibility, and approval are subject to underwriting review and the
        originating lender's program requirements. Property types, locations, and borrower scenarios may not
        qualify under all programs. Rates, terms, and programs subject to change without notice. This company is
        not endorsed by, or acting on behalf of, any government agency.
      </p>
      <p>
        By submitting your information, you consent to be contacted by {brand.name} via phone, SMS, or email
        regarding your inquiry, even if your number is on a Do Not Call list. Consent is not a condition of any
        loan or service. Message and data rates may apply.
      </p>
    </div>
    <div class="flex items-center justify-center gap-8 mt-8">
      <a href="/privacy" class="text-[0.8rem] underline hover:text-cream">Privacy Policy</a>
      <svg width="34" height="34" viewBox="0 0 24 24" fill="currentColor" role="img" aria-label="Equal Housing Opportunity">
        <path d="M12 2 1 10h2v12h18V10h2L12 2zm0 2.5L18.5 9h-13L12 4.5zM5 11h14v9H5v-9zm3 2v2h8v-2H8zm0 3.5v2h8v-2H8z"/>
      </svg>
      <a href="/legal" class="text-[0.8rem] underline hover:text-cream">Legal</a>
    </div>
    <p class="text-[0.72rem] mt-8 text-cream/40">© {new Date().getFullYear()} {brand.name}. All rights reserved.</p>
  </div>
</footer>
